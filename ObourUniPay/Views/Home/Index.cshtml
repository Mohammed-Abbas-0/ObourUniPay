@{
    ViewData["Title"] = "Modern Queue Experience";
}

<div class="container-fluid min-vh-100 d-flex flex-column align-items-center justify-content-center p-4">

    <!-- Ultra-Modern Hero -->
    <div class="text-center animate-entrance" style="max-width: 900px;">
        <div
            class="d-inline-flex align-items-center bg-white bg-opacity-5 border border-white border-opacity-10 rounded-pill px-4 py-2 text-white mb-5">
            <span class="fs-6 fw-500 opacity-80">State-of-the-Art Queue System</span>
            <div class="mx-3 opacity-20">|</div>
            <span class="text-primary-brand fw-bold small">v3.0 IMMERSIVE</span>
        </div>

        <h1 class="hero-title text-white">
            Effortless Waiting. <br>
            <span class="opacity-50">Infinite Possibilities.</span>
        </h1>

        <p class="hero-sub mx-auto text-light opacity-60">
            Obour University's next-generation booking interface. Designed for speed, precision, and the ultimate
            student experience.
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-4">
            <a asp-controller="Queue" asp-action="Index" class="btn-precision px-5 py-4">
                Get Your Turn <i class="bi bi-chevron-right ms-2 fs-5"></i>
            </a>
            <a asp-controller="Admin" asp-action="Index" class="btn-precision-outline px-5 py-4">
                Admin Portal
            </a>
        </div>
    </div>

    <!-- Decorative Element: Linear Beam -->
    <div class="position-absolute bottom-0 start-50 translate-middle-x bg-primary opacity-20 blur-3xl animate-glow"
        style="width: 80vw; height: 100px; filter: blur(120px); border-radius: 100%;"></div>

    <!-- Features Bento Preview -->
    <div class="container mt-auto pt-5 pb-5">
        <div class="row g-4 animate-entrance" style="animation-delay: 0.4s;">
            <div class="col-md-4">
                <div class="glass-surface p-4 rounded-xl d-flex align-items-center">
                    <div class="avatar-md bg-white bg-opacity-5 rounded-lg d-flex align-items-center justify-content-center me-3"
                        style="width: 48px; height: 48px;">
                        <i class="bi bi-lightning text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-600">Instant Booking</div>
                        <div class="small opacity-40">Zero setup required</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-surface p-4 rounded-xl d-flex align-items-center">
                    <div class="avatar-md bg-white bg-opacity-5 rounded-lg d-flex align-items-center justify-content-center me-3"
                        style="width: 48px; height: 48px;">
                        <i class="bi bi-shield-check text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-600">Secure Access</div>
                        <div class="small opacity-40">Student ID Verification</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-surface p-4 rounded-xl d-flex align-items-center">
                    <div class="avatar-md bg-white bg-opacity-5 rounded-lg d-flex align-items-center justify-content-center me-3"
                        style="width: 48px; height: 48px;">
                        <i class="bi bi-arrow-repeat text-info fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-600">Daily Sync</div>
                        <div class="small opacity-40">Resets at midnight</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-500 {
        font-weight: 500;
    }

    .fw-600 {
        font-weight: 600;
    }

    .text-primary-brand {
        color: var(--primary-brand);
    }
</style>
