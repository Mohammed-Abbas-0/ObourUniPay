@{
    ViewData["Title"] = "الرئيسية";
}

<div class="section-py">
    <div class="container animate-fade-in">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 text-center text-lg-start">
                <!-- Brand Badge -->
                <div class="mb-4">
                    <span
                        class="badge rounded-pill bg-soft-indigo text-primary-app px-4 py-2 border border-primary-app border-opacity-10 fw-600">
                        Official Obour University Portal
                    </span>
                </div>

                <!-- Immersive Hero Typography -->
                <h1 class="display-2 mb-4" style="line-height: 1.1; font-weight: 900; color: #0f172a;">
                    Obour Uni
                </h1>
                <p class="lead mb-5" style="max-width: 600px; font-size: 1.25rem; color: #64748b;">
                    استمتع بنظام حجز الأدوار الرقمي الجديد من جامعة عبور. سجل دورك بلمحة، وانتظر في راحتك مع خدماتنا المتكاملة.
                </p>

                <!-- Premium Actions -->
                <div class="d-flex flex-column flex-md-row gap-3 mb-5 justify-content-center justify-content-lg-start">
                    <a asp-controller="Queue" asp-action="Index" class="btn-modern px-5 py-3 fs-5">
                        ابدأ دوري الآن <i class="bi bi-arrow-left-short ms-2"></i>
                    </a>
                    <a href="#features" class="btn-modern-outline px-5 py-3 fs-5">
                        كيف يعمل النظام؟
                    </a>
                </div>
            </div>

            <!-- Entrance QR Card -->
            <div class="col-lg-5">
                <div class="card-clean text-center p-4 border-primary-app border-opacity-10"
                    style="background: #ffffff; box-shadow: 0 30px 60px rgba(99, 102, 241, 0.08);">
                    <div class="mb-3">
                        <span class="badge bg-soft-indigo text-primary-app px-3 py-1 rounded-pill small fw-700">دخول
                            سريع</span>
                    </div>
                    <div class="bg-white p-3 rounded-4 shadow-sm d-inline-block mb-3 border border-light">
                        <img src="/images/portal_qr.png" alt="Portal QR" class="img-fluid" style="max-width: 200px;" />
                    </div>
                    <h4 class="fw-800 mb-2">امسح للدخول</h4>
                    <p class="text-muted small mb-0">يمكنك مسح هذا الكود مباشرة من هاتفك للانضمام إلى قائمة الانتظار
                        فوراً.</p>
                </div>
            </div>
        </div>

        <!-- Visual Anchor -->
        <div class="mt-5 pt-5 opacity-50 text-center">
            <div class="d-inline-flex align-items-center gap-4 text-muted small fw-600 tracking-widest text-uppercase">
                <span>سريع</span>
                <i class="bi bi-dot"></i>
                <span>رقمي</span>
                <i class="bi bi-dot"></i>
                <span>متكامل</span>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div id="features" class="section-py"
    style="background-color: rgba(0,0,0,0.01); border-top: 1px solid var(--border-app);">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card-clean h-100 p-5">
                    <div class="text-primary-app mb-4">
                        <i class="bi bi-lightning-charge fs-1"></i>
                    </div>
                    <h3 class="mb-3">حجز فوري</h3>
                    <p class="text-muted mb-0">امسح كارت الطالب الخاص بك أو ادخل الباركود لتحصل على رقم دورك في ثوانٍ
                        معدودة.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-clean h-100 p-5">
                    <div class="text-primary-app mb-4">
                        <i class="bi bi-shield-check fs-1"></i>
                    </div>
                    <h3 class="mb-3">هوية موثقة</h3>
                    <p class="text-muted mb-0">النظام مرتبط مباشرة بسجلات شؤون الطلاب لضمان الدقة والأمان في كل معاملة.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-clean h-100 p-5">
                    <div class="text-primary-app mb-4">
                        <i class="bi bi-printer fs-1"></i>
                    </div>
                    <h3 class="mb-3">تذاكر رقمية</h3>
                    <p class="text-muted mb-0">احصل على تذكرة رقمية على هاتفك أو اطبعها لتبرزها عند الموظف المختص.</p>
                </div>
            </div>
        </div>
    </div>
</div>
