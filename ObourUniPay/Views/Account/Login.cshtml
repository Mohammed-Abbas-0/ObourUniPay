@model Obour_Uni_Pay.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "دخول الموظفين";
    Layout = "_Layout";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card-clean animate-fade-in" style="max-width: 450px; width: 100%;">

        <div class="text-center mb-5">
            <div class="d-inline-flex p-4 rounded-circle bg-soft-indigo mb-4">
                <i class="bi bi-shield-lock text-primary-app fs-1"></i>
            </div>
            <h2 class="fw-800 text-main mb-2">دخول النظام</h2>
            <p class="text-muted small text-uppercase fw-600">يُمنع دخول غير المصرح لهم</p>
        </div>

        <form asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
            <div asp-validation-summary="All" class="text-danger small mb-4"></div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label text-muted small fw-600 mb-2">البريد الإلكتروني للهوية</label>
                <input asp-for="Email" class="form-control-clean py-3" placeholder="name@obour.edu.eg" required />
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label text-muted small fw-600 mb-2">كلمة المرور (رمز
                    المرور)</label>
                <input asp-for="Password" class="form-control-clean py-3" placeholder="••••••••" required />
            </div>

            <div class="mb-5 d-flex align-items-center">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label text-muted small ms-2">تذكر تسجيل الدخول</label>
                </div>
            </div>

            <button type="submit" class="btn-modern w-100 py-3">
                تأكيد الدخول <i class="bi bi-arrow-left-short ms-1"></i>
            </button>
        </form>

        <div class="mt-5 pt-4 border-top border-dark border-opacity-5 text-center">
            <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none hover-primary">
                <i class="bi bi-arrow-right ms-1"></i> العودة للرئيسية
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('loginForm').onsubmit = function  () {         const btn = this.querySelector('button');         btn.innerHTML = '<span class="spinner-border spinner-border-sm ms-2"></span> جاري التحقق...';         btn.disabled = true;     };
    </script>
}
