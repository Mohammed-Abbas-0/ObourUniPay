@{
    ViewData["Title"] = "Access Denied";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="text-center animate-entrance">
        <div class="display-1 text-danger mb-4">
            <i class="bi bi-shield-slash"></i>
        </div>
        <h1 class="hero-title text-white">Access Denied.</h1>
        <p class="hero-sub mx-auto">Your current clearance level is insufficient to access this terminal segment.</p>

        <div class="mt-5">
            <a asp-controller="Home" asp-action="Index" class="btn-precision px-5">Return Home</a>
        </div>
    </div>
</div>
