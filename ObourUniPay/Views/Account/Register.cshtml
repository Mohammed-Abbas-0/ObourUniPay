@model Obour_Uni_Pay.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "إنشاء حساب موظف";
}

<div class="container section-py animate-fade-in">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">
        <div>
            <h1 class="display-4 fw-800 text-main mb-2">إضافة موظف جديد</h1>
            <p class="text-muted mb-0 fw-500">إنشاء صلاحيات وصول جديدة لموظفي الجامعة المسجلين.</p>
        </div>
        <a asp-controller="Admin" asp-action="Index" class="btn-modern-outline">
            <i class="bi bi-x-lg ms-2"></i> إلغاء العملية
        </a>
    </div>

    <div class="card-clean p-4 p-md-5 mx-auto" style="max-width: 650px; background: #ffffff;">
        <form asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger small mb-4"></div>

            <div class="row g-4">
                <div class="col-md-12">
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label-clean">البريد الإلكتروني المخصص</label>
                        <input asp-for="Email" class="form-control-clean py-3" placeholder="user@obour.edu.eg"
                            required />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label-clean">كلمة المرور الأولية</label>
                        <input asp-for="Password" class="form-control-clean py-3" placeholder="••••••••" required />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label-clean">تأكيد كلمة المرور</label>
                        <input asp-for="ConfirmPassword" class="form-control-clean py-3" placeholder="••••••••"
                            required />
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="mb-5">
                        <label asp-for="Role" class="form-label-clean">مستوى الصلاحيات (الدور)</label>
                        <select asp-for="Role" class="form-control-clean py-3">
                            <option value="Staff">موظف (عرض السجل فقط)</option>
                            <option value="Admin">مدير بنظام كامل (صلاحيات كاملة)</option>
                        </select>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-modern w-100 py-4 fs-5">
                تأكيد التسجيل وإضافة الموظف <i class="bi bi-person-plus ms-2"></i>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
