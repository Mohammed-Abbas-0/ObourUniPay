@model ObourUniPay.Core.Models.QueueTurn
@{
    ViewData["Title"] = "تذكرتك الرقمية";
}

<div class="container section-py animate-fade-in">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card-clean p-0 overflow-hidden shadow-premium border-primary-app border-opacity-10"
                style="background: #ffffff;">
                <!-- Ticket Header -->
                <div class="bg-soft-indigo p-4 text-center border-bottom border-dark border-opacity-5">
                    <span
                        class="btn-modern-outline bg-white border-dark border-opacity-10 py-1 px-3 fs-6 d-inline-flex mb-3 text-uppercase tracking-widest shadow-sm">
                        تذكرة دور الجامعية
                    </span>
                    <h1 class="display-1 m-0 text-primary-app" style="font-weight: 900; letter-spacing: -2px;">
                        @Model.TurnNumber</h1>
                    <p class="text-muted fw-700 mb-0 small text-uppercase">رقم دورك الآن</p>
                </div>

                <!-- Ticket Content -->
                <div class="p-4">
                    <div class="bg-light rounded-4 p-4 mb-4 border border-dark border-opacity-5">
                        <div
                            class="d-flex justify-content-between mb-3 pb-3 border-bottom border-dark border-opacity-5">
                            <span class="text-muted fw-600">اسم الطالب</span>
                            <span class="fw-800 text-main">@Model.Student?.Name</span>
                        </div>
                        <div
                            class="d-flex justify-content-between mb-3 pb-3 border-bottom border-dark border-opacity-5">
                            <span class="text-muted fw-600">القسم / التخصص</span>
                            <span class="fw-800 text-main">@(Model.Student?.Department?.Name ?? "غير محدد")</span>
                        </div>
                        <div
                            class="d-flex justify-content-between mb-3 pb-3 border-bottom border-dark border-opacity-5">
                            <span class="text-muted fw-600">المرحلة الدراسية</span>
                            <span class="fw-800 text-main">@(Model.Student?.Stage ?? "غير محدد")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted fw-600">وقت الإصدار</span>
                            <span class="fw-800 text-main">@Model.CreatedAt.ToString("hh:mm tt").Replace("AM",
                                "صباحاً").Replace("PM", "مساءً")</span>
                        </div>
                    </div>

                    <div class="text-center">
                        <p class="text-muted small mb-4 px-4 fw-500">
                            برجاء البقاء بالقرب من مكتب الخدمة. سيتم مناداة رقم دورك قريباً عبر شاشات العرض.
                        </p>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-3 d-print-none">
                            <button onclick="window.print()" class="btn-modern w-100 py-3">
                                <i class="bi bi-printer ms-2"></i> طباعة التذكرة
                            </button>
                            <a asp-action="Index" class="btn-modern-outline w-100 py-3">
                                تسجيل جديد <i class="bi bi-arrow-left-short ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Ticket Footer Art -->
                <div class="p-3 bg-light text-center">
                    <div class="text-muted opacity-50 small fw-bold tracking-widest">
                        Obour Digital System • Obour Pay
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-500 {
        font-weight: 500;
    }

    .fw-800 {
        font-weight: 800;
    }

    @@media print {
        body {
            background: white !important;
            color: black !important;
            direction: rtl !important;
        }

        .section-py {
            padding: 0 !important;
        }

        .container {
            padding: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }

        .card-clean {
            border: 1px solid #eee !important;
            box-shadow: none !important;
            background: white !important;
            border-radius: 0 !important;
        }

        .bg-soft-indigo,
        .bg-light {
            background: transparent !important;
            border: 1px solid #f0f0f0 !important;
        }

        .text-primary-app,
        .text-muted,
        .text-main {
            color: black !important;
        }

        .d-print-none {
            display: none !important;
        }

        .display-1 {
            font-size: 8rem !important;
            margin: 20px 0 !important;
        }
    }
</style>
