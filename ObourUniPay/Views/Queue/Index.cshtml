@{
    ViewData["Title"] = "Identification";
}

<div class="container d-flex align-items-center justify-content-center py-5" style="min-height: 85vh;">
    <div class="booth-container animate-entrance">
        
        <div class="text-center mb-5">
            <div class="d-inline-flex p-4 rounded-circle bg-white bg-opacity-5 border border-white border-opacity-10 mb-4">
                <i class="bi bi-person-bounding-box text-white fs-1 animate-glow"></i>
            </div>
            <h2 class="fw-700 text-white mb-2">Scanning Booth</h2>
            <p class="text-dim small text-uppercase tracking-widest">Verify Student Identity</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="glass-surface border-danger border-opacity-30 p-3 rounded-xl mb-4 text-center animate-shake" style="background: rgba(239, 68, 68, 0.05);">
                <span class="text-danger small fw-600">
                    <i class="bi bi-shield-exclamation me-2"></i> @ViewBag.Error
                </span>
            </div>
        }

        <form asp-action="GetTurn" method="post" id="boothForm">
            <div class="mb-5 px-3">
                <input type="text" class="neon-input" 
                       id="barcode" name="barcode" 
                       placeholder="000000" autofocus required autocomplete="off" />
                <div class="text-center mt-3">
                    <span class="text-dim small opacity-40">Place ID card near the scanner range</span>
                </div>
            </div>

            <button type="submit" class="btn-precision w-100 py-4 fs-5">
                Confirm Identity <i class="bi bi-fingerprint ms-2"></i>
            </button>
        </form>

        <div class="mt-5 pt-4 border-top border-white border-opacity-5 d-flex justify-content-between align-items-center opacity-40">
            <div class="small d-flex align-items-center">
                <span class="rounded-circle bg-success me-2" style="width: 6px; height: 6px;"></span> Secure Node
            </div>
            <div class="small" id="reset-timer">--:--:--</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const barcodeInput = document.getElementById('barcode');
        const timerEl = document.getElementById('reset-timer');

        // Maintain Focus
        document.addEventListener('click', () => barcodeInput.focus());
        barcodeInput.focus();

        // System Timer
        function updateTimer() {
            const now = new Date();
            const tomorrow = new Date();
            tomorrow.setHours(24, 0, 0, 0);
            const diff = tomorrow - now;
            const h = Math.floor(diff / 3600000);
            const m = Math.floor((diff / 60000) % 60);
            const s = Math.floor((diff / 1000) % 60);
            timerEl.innerText = `${h.toString().padStart(2,'0')}:${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
        }
        setInterval(updateTimer, 1000);
        updateTimer();

        // Haptic-style feedback on form submit
        document.getElementById('boothForm').onsubmit = function() {
            const btn = this.querySelector('button');
            btn.innerHTML = '<span class="spinner-grow spinner-grow-sm me-2"></span> Verifying...';
            btn.style.opacity = '0.7';
        };
    </script>
}

<style>
    .fw-700 { font-weight: 700; }
    .fw-600 { font-weight: 600; }
    
    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
    }
    .animate-shake { animation: shake 0.4s ease-in-out; }
</style>
