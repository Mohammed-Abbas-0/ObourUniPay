@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="container section-py animate-fade-in">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card-clean text-center">
                <div class="mb-4">
                    <div class="bg-soft-indigo d-inline-flex p-4 rounded-circle text-primary-app mb-3">
                        <i class="bi bi-person-check-fill fs-1"></i>
                    </div>
                    <h2 class="fw-700">هوية الطالب</h2>
                    <p class="text-muted">امسح كارت الطالب أو ادخل رقم الباركود للمتابعة.</p>
                </div>

                <!-- Error Display -->
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger rounded-4 mb-4">
                        <i class="bi bi-exclamation-circle-fill ms-2"></i> @ViewBag.Error
                    </div>
                }

                <form asp-action="GetTurn" method="post" id="loginForm" class="text-start">
                    <div class="mb-4">
                        <label for="barcode" class="form-label-clean">باركود الطالب / رقم الهوية</label>
                        <input type="text" class="form-control-clean fs-4 text-center fw-700 py-3" 
                               id="barcode" name="barcode" 
                               placeholder="امسح أو اكتب هنا..." autofocus required autocomplete="off" />
                    </div>

                    <button type="submit" class="btn-modern w-100 py-3 fs-5">
                         تأكيد الهوية وإصدار التذكرة <i class="bi bi-arrow-left-short ms-2"></i>
                    </button>
                    
                    <div class="text-center mt-4">
                        <p class="text-muted small">
                            يتم إعادة تعيين السجلات تلقائياً كل منتصف ليل.
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const barcodeInput = document.getElementById('barcode');
        document.addEventListener('click', () => barcodeInput.focus());
        
        document.getElementById('loginForm').onsubmit = function() {
            const btn = this.querySelector('button');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm ms-2"></span> جاري التحقق...';
            btn.disabled = true;
        };
    </script>
}
