<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Obour Pay</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm mb-0">
            <div class="container px-4">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Logo" class="ms-2"
                        style="width: 32px; height: 32px; object-fit: contain;" />
                    Obour Pay
                </a>
                <button class="navbar-toggler border-dark border-opacity-10" type="button" data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse">
                    <span class="bi bi-list text-dark"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav gap-2 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Queue" asp-action="Index">حجز دور</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">لوحة التحكم</a>
                            </li>
                            <li class="nav-item me-sm-3 d-flex align-items-center gap-3">
                                <span class="text-main small fw-600">
                                    <i class="bi bi-person-circle ms-1 opacity-50"></i> @User.Identity.Name
                                </span>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit"
                                        class="btn btn-link text-danger text-opacity-75 p-0 text-decoration-none">
                                        <i class="bi bi-power fs-5"></i>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-sm-2">
                                <a class="btn-modern-outline py-2 px-3 small" asp-controller="Admin" asp-action="Index">
                                    دخول المشرفين
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="mt-auto py-5 border-top border-dark border-opacity-5">
        <div class="container text-center">
            <p class="text-muted small mb-0">
                &copy; @DateTime.Now.Year Obour Pay • <span class="text-primary-app">Premium Portal</span>
                <span class="mx-2 opacity-20">|</span>
                <a asp-action="Privacy" class="text-muted text-decoration-none hover-primary">شروط الخدمة</a>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <style>
        .hover-primary:hover {
            color: var(--primary-app) !important;
        }

        .text-main {
            color: var(--text-main);
        }

        .fw-600 {
            font-weight: 600;
        }
    </style>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
