<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Obour University</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm mb-0">
            <div class="container px-4">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard me-2"></i> Obour Uni Pay
                </a>
                <button class="navbar-toggler border-white border-opacity-10" type="button" data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false"
                    aria-label="Toggle navigation">
                    <span class="bi bi-list text-white"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav gap-3 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link text-white opacity-60 hover-opacity-100 fw-500" asp-controller="Home"
                                asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white opacity-60 hover-opacity-100 fw-500" asp-controller="Queue"
                                asp-action="Index">Student Queue</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white opacity-60 hover-opacity-100 fw-500" asp-controller="Admin"
                                    asp-action="Students">Registry</a>
                            </li>
                            <li class="nav-item ms-sm-3 d-flex align-items-center gap-3">
                                <div class="nav-link btn-precision-outline border-0 py-2 d-flex align-items-center">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                                </div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit"
                                        class="btn btn-sm btn-link text-white opacity-40 hover-opacity-100 p-0 text-decoration-none">
                                        <i class="bi bi-power fs-5"></i>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-sm-3">
                                <a class="nav-link btn-precision-outline border-0 py-2" asp-controller="Admin"
                                    asp-action="Index">
                                    <i class="bi bi-lock me-1"></i> Admin Portal
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="mt-auto py-5 border-top border-white border-opacity-5">
        <div class="container text-center">
            <p class="text-dim small mb-0">
                &copy; 2025 Obour University Payment System.
                <span class="mx-2 opacity-20">|</span>
                <a asp-action="Privacy" class="text-dim text-decoration-none hover-white">Privacy Protocol</a>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <style>
        .hover-opacity-100:hover {
            opacity: 1 !important;
            transition: opacity 0.2s ease;
        }

        .hover-white:hover {
            color: white !important;
        }

        .fw-500 {
            font-weight: 500;
        }
    </style>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
