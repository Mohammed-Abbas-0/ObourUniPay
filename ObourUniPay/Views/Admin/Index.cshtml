@model List<Obour_Uni_Pay.Models.QueueTurn>
@{
    ViewData["Title"] = "لوحة التحكم";
    var pending = Model.Count(t => t.Status == Obour_Uni_Pay.Models.TurnStatus.Pending);
}

<div class="container section-py animate-fade-in">
    <!-- Premium Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">
        <div>
            <h1 class="display-4 fw-800 text-main mb-2">لوحة مراقبة الدور</h1>
            <p class="text-muted mb-0">مراقبة وإدارة تدفق الطلاب اليومي للخدمات.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Students" class="btn-modern-outline text-decoration-none">
                <i class="bi bi-people ms-2"></i> سجل الطلاب
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Account" asp-action="Register" class="btn-modern-outline text-decoration-none">
                    <i class="bi bi-person-plus ms-2"></i> إضافة موظف
                </a>
            }
        </div>
    </div>

    <!-- Stats Row (Modern Light Bento) -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card-clean d-flex align-items-center justify-content-between h-100"
                style="background: #ffffff;">
                <div>
                    <span class="text-muted small fw-700 text-uppercase tracking-widest">إجمالي الطلاب</span>
                    <h2 class="display-5 fw-900 m-0">@Model.Count</h2>
                </div>
                <div class="bg-soft-indigo p-3 rounded-circle text-primary-app">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-clean d-flex align-items-center justify-content-between h-100"
                style="border-right: 3px solid var(--primary-app); background: #ffffff;">
                <div>
                    <span class="text-muted small fw-700 text-uppercase tracking-widest">في الانتظار حالياً</span>
                    <h2 class="display-5 fw-900 m-0 text-primary-app">@pending</h2>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                    <i class="bi bi-hourglass-split fs-3"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-clean d-flex align-items-center justify-content-between h-100"
                style="background: #ffffff; border: 1px dashed var(--primary-app);">
                <div>
                    <span class="text-primary-app small fw-800 text-uppercase tracking-widest">كود الدخول (QR)</span>
                    <p class="text-muted small mb-3">رمز مسح الدخول السريع</p>
                    <button type="button" class="btn-modern px-4 py-2 small" data-bs-toggle="modal"
                        data-bs-target="#qrModal">
                        <i class="bi bi-qr-code ms-1"></i> عرض الكود
                    </button>
                </div>
                <div class="text-primary-app opacity-20">
                    <i class="bi bi-qr-code-scan fs-1"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- QR Modal -->
    <div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-premium" style="background: #ffffff;">
                <div class="modal-body text-center p-5">
                    <h4 class="fw-900 mb-4 text-main">رمز الدخول للبوابة</h4>
                    <div class="bg-light p-4 rounded-4 shadow-sm d-inline-block mb-4 border border-light">
                        <div id="qrcode"></div>
                    </div>
                    <p class="text-muted mb-4 fs-6">
                        قم بطباعة هذا الكود ووضعه عند مدخل الجامعة <br> ليتمكن الطلاب من مسحه والانضمام للدور.
                    </p>
                    <div class="d-grid gap-3">
                        <button onclick="shareQR()" class="btn-modern py-3">
                            <i class="bi bi-share ms-2"></i> مشاركة الرابط
                        </button>
                        <button onclick="window.print()" class="btn-modern-outline py-3">
                            <i class="bi bi-printer ms-2"></i> طباعة كود الوصول
                        </button>
                        <button type="button" class="btn-modern-outline py-3 border-0" data-bs-dismiss="modal">إغلاق
                            النافذة</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Registry List -->
    <div class="card-clean p-0 overflow-hidden" style="background: #ffffff;">
        <div
            class="p-4 border-bottom border-dark border-opacity-5 d-flex justify-content-between align-items-center bg-light bg-opacity-50">
            <h5 class="fw-800 m-0">سجل الدور اليومي</h5>
            <span
                class="badge rounded-pill bg-white border border-dark border-opacity-10 text-main px-3 py-2 fw-700 shadow-sm">
                @DateTime.Now.ToString("dd MMM yyyy")
            </span>
        </div>
        <div class="table-responsive">
            <table class="table-simple">
                <thead>
                    <tr>
                        <th>رقم الدور</th>
                        <th>بيانات الطالب</th>
                        <th>القسم</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <i class="bi bi-inbox text-muted fs-1 mb-3 d-block"></i>
                                <p class="text-muted">لا يوجد طلاب في الدور اليوم حتى الآن.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-800 fs-5 text-primary-app">#@item.TurnNumber</td>
                                <td>
                                    <div class="fw-700 text-main">@item.Student?.Name</div>
                                    <div class="small text-muted">الهوية: @item.Student?.Barcode</div>
                                </td>
                                <td>
                                    <div class="text-main fw-700">@(item.Student?.Department?.Name ?? "غير محدد")</div>
                                    <div class="small text-muted">@item.Student?.Stage</div>
                                </td>
                                <td>
                                    @if (item.Status == Obour_Uni_Pay.Models.TurnStatus.Pending)
                                    {
                                        <span class="badge badge-waiting px-3 py-2 fw-600">
                                            في الانتظار
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success px-3 py-2 fw-600">
                                            تمت الخدمة
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .fw-800 {
        font-weight: 800;
    }

    .fw-700 {
        font-weight: 700;
    }

    .fw-600 {
        font-weight: 600;
    }

    .fw-500 {
        font-weight: 500;
    }

    @@media print {

        header,
        .navbar,
        .btn-modern,
        .btn-modern-outline,
        .modal-footer,
        .d-flex.gap-2,
        .display-4,
        p.text-muted,
        .row.g-4.mb-5,
        .card-clean:not(.modal-content) {
            display: none !important;
        }

        .modal {
            position: static;
            display: block;
            opacity: 1;
        }

        .modal-dialog {
            margin: 0;
            max-width: 100%;
        }

        .modal-content {
            border: none !important;
            background: white !important;
        }

        .modal-content h4,
        .modal-content p {
            color: black !important;
        }

        .card-clean {
            background: white !important;
            color: black !important;
        }
    }
</style>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        const qrContent = "https://obouruni.runasp.net/Queue";
        const qrContainer = document.getElementById("qrcode");

        new QRCode(qrContainer, {
            text: qrContent,
            width: 250,
            height: 250,
            colorDark: "#0f172a",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.H
        });

        async function shareQR() {
            const shareData = {
                title: 'بوابة Obour Pay',
                text: 'يمكنك الانضمام للدور من هنا:',
                url: qrContent
            };

            try {
                if (navigator.share) {
                    await navigator.share(shareData);
                } else {
                    await navigator.clipboard.writeText(qrContent);
                    alert("تم نسخ الرابط بنجاح!");
                }
            } catch (err) {
                console.log("Sharing failed", err);
            }
        }
    </script>
}
