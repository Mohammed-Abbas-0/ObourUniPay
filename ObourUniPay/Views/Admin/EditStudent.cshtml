@model Obour_Uni_Pay.Models.Student
@{
    ViewData["Title"] = "Update Identity";
}

<div class="container py-5 mt-4">
    <div class="d-flex justify-content-between align-items-end mb-5 animate-entrance">
        <div>
            <h1 class="hero-title text-white mb-2" style="font-size: 3rem;">Update.</h1>
            <p class="text-dim mb-0">Modify student identity parameters.</p>
        </div>
        <a asp-action="Students" class="btn-precision-outline">
            <i class="bi bi-x-lg me-2"></i> Cancel
        </a>
    </div>

    <div class="glass-surface p-5 rounded-xl animate-entrance" style="max-width: 800px; margin: 0 auto;">
        <form asp-action="EditStudent" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger small mb-4"></div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="Name" class="form-label text-dim small fw-600 mb-2">FULL NAME</label>
                    <input asp-for="Name"
                        class="form-control bg-white bg-opacity-5 border-white border-opacity-10 text-white py-3 rounded-md"
                        required />
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="Barcode" class="form-label text-dim small fw-600 mb-2">BARCODE / ID</label>
                    <input asp-for="Barcode"
                        class="form-control bg-white bg-opacity-5 border-white border-opacity-10 text-white py-3 rounded-md"
                        required />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="Email" class="form-label text-dim small fw-600 mb-2">INSTITUTIONAL EMAIL</label>
                    <input asp-for="Email"
                        class="form-control bg-white bg-opacity-5 border-white border-opacity-10 text-white py-3 rounded-md" />
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="PhoneNumber" class="form-label text-dim small fw-600 mb-2">CONTACT NUMBER</label>
                    <input asp-for="PhoneNumber"
                        class="form-control bg-white bg-opacity-5 border-white border-opacity-10 text-white py-3 rounded-md" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-4">
                    <label asp-for="Department" class="form-label text-dim small fw-600 mb-2">DEPARTMENT</label>
                    <input asp-for="Department"
                        class="form-control bg-white bg-opacity-5 border-white border-opacity-10 text-white py-3 rounded-md" />
                </div>
                <div class="col-md-4 mb-4">
                    <label asp-for="Stage" class="form-label text-dim small fw-600 mb-2">ACADEMIC STAGE</label>
                    <input asp-for="Stage"
                        class="form-control bg-white bg-opacity-5 border-white border-opacity-10 text-white py-3 rounded-md" />
                </div>
                <div class="col-md-4 mb-4">
                    <label asp-for="Gender" class="form-label text-dim small fw-600 mb-2">GENDER</label>
                    <select asp-for="Gender"
                        class="form-select bg-white bg-opacity-5 border-white border-opacity-10 text-white py-3 rounded-md">
                        <option value="Male" class="bg-dark">Male</option>
                        <option value="Female" class="bg-dark">Female</option>
                    </select>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="BirthDate" class="form-label text-dim small fw-600 mb-2">DATE OF BIRTH</label>
                <input asp-for="BirthDate" type="date"
                    class="form-control bg-white bg-opacity-5 border-white border-opacity-10 text-white py-3 rounded-md" />
            </div>

            <button type="submit" class="btn-precision w-100 py-4 mt-4">
                Update Record <i class="bi bi-arrow-repeat ms-2"></i>
            </button>
        </form>
    </div>
</div>

<style>
    .form-control:focus,
    .form-select:focus {
        background: rgba(255, 255, 255, 0.08) !important;
        border-color: var(--primary-brand);
        box-shadow: 0 0 20px var(--primary-glow);
        color: white;
    }

    .rounded-md {
        border-radius: 12px;
    }
</style>
