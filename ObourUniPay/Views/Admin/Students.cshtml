@model List<Obour_Uni_Pay.Models.Student>
@{
    ViewData["Title"] = "سجل الطلاب";
}

<div class="container section-py animate-fade-in">
    <!-- Registry Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">
        <div>
            <h1 class="display-4 fw-800 text-main mb-2">سجل الطلاب</h1>
            <p class="text-muted mb-0">إدارة هويات الطلاب والتحقق من البيانات الأكاديمية.</p>
        </div>
        <a asp-action="CreateStudent" class="btn-modern">
            <i class="bi bi-person-plus ms-2"></i> تسجيل طالب جديد
        </a>
    </div>

    <!-- Registry Card (Bento Style) -->
    <div class="card-clean p-0 overflow-hidden" style="background: #ffffff;">
        <div
            class="p-4 border-bottom border-dark border-opacity-5 d-flex justify-content-between align-items-center bg-light bg-opacity-50">
            <div>
                <div class="fw-800 text-main">سجل البيانات الكامل</div>
                <div class="small text-muted fw-600">الإجمالي: @Model.Count طالب</div>
            </div>
            <a asp-action="FixData"
                class="btn-modern-outline py-2 px-3 small border-warning text-warning text-decoration-none">
                <i class="bi bi-magic ms-1"></i> تصحيح البيانات القديمة
            </a>
        </div>
        <div class="table-responsive">
            <table class="table-simple">
                <thead>
                    <tr>
                        <th class="fw-700">الباركود / الهوية</th>
                        <th class="fw-700">اسم الطالب</th>
                        <th class="fw-700">القسم والسنة</th>
                        <th class="fw-700">بيانات التواصل</th>
                        <th class="fw-700">العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <code
                                    class="text-primary-app fw-700 bg-light px-2 py-1 rounded border border-dark border-opacity-5">@item.Barcode</code>
                            </td>
                            <td>
                                <div class="fw-800 text-main">@item.Name</div>
                                <div class="small text-muted fw-600">@(item.Gender == "Male" ? "ذكر" : "أنثى")</div>
                            </td>
                            <td>
                                <div class="text-main fw-700">@(item.Department?.Name ?? "غير محدد")</div>
                                <div class="small text-muted fw-600">@item.Stage</div>
                            </td>
                            <td>
                                <div class="small text-main fw-700">@item.Email</div>
                                <div class="small text-muted fw-600">@item.PhoneNumber</div>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="EditStudent" asp-route-id="@item.Id"
                                        class="btn btn-sm text-dark opacity-50 hover-opacity-100 p-0 fs-5">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="DeleteStudent" asp-route-id="@item.Id" method="post"
                                        onsubmit="return confirm('هل أنت متأكد من أرشفة سجل هذا الطالب؟');"
                                        class="d-inline">
                                        <button type="submit"
                                            class="btn btn-sm text-danger opacity-50 hover-opacity-100 p-0 fs-5 border-0 bg-transparent">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .fw-800 {
        font-weight: 800;
    }

    .fw-700 {
        font-weight: 700;
    }

    .hover-opacity-100:hover {
        opacity: 1 !important;
    }
</style>
