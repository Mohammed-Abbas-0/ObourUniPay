@model List<Obour_Uni_Pay.Models.Student>
@{
    ViewData["Title"] = "Student Registry";
}

<div class="container py-5 mt-4">
    <div class="d-flex justify-content-between align-items-end mb-5 animate-entrance">
        <div>
            <h1 class="hero-title text-white mb-2" style="font-size: 3rem;">Student Registry.</h1>
            <p class="text-dim mb-0">Manage university student identities and clearance.</p>
        </div>
        <a asp-action="CreateStudent" class="btn-precision">
            <i class="bi bi-person-plus me-2"></i> Enroll Student
        </a>
    </div>

    <div class="glass-surface rounded-xl overflow-hidden animate-entrance" style="animation-delay: 0.1s;">
        <div
            class="px-4 py-3 border-bottom border-white border-opacity-5 d-flex justify-content-between align-items-center">
            <div class="fw-700 text-white">Full Registry Log</div>
            <div class="small text-dim">Total: @Model.Count Students</div>
        </div>
        <div class="table-responsive">
            <table class="precision-table">
                <thead>
                    <tr>
                        <th>Barcode/ID</th>
                        <th>Student Name</th>
                        <th>Department & Stage</th>
                        <th>Contact</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <code class="text-primary-brand fw-bold">@item.Barcode</code>
                            </td>
                            <td>
                                <div class="fw-600 text-white">@item.Name</div>
                                <div class="small text-dim opacity-50">@item.Gender</div>
                            </td>
                            <td>
                                <div class="text-white small">@item.Department</div>
                                <div class="small text-dim opacity-50">Stage @item.Stage</div>
                            </td>
                            <td>
                                <div class="small text-dim">@item.Email</div>
                                <div class="small text-dim opacity-50">@item.PhoneNumber</div>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="EditStudent" asp-route-id="@item.Id"
                                        class="btn btn-sm text-white opacity-40 hover-opacity-100">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="DeleteStudent" asp-route-id="@item.Id" method="post"
                                        onsubmit="return confirm('Archive this student record?');">
                                        <button type="submit" class="btn btn-sm text-danger opacity-40 hover-opacity-100">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .fw-700 {
        font-weight: 700;
    }

    .fw-600 {
        font-weight: 600;
    }

    .text-primary-brand {
        color: var(--primary-brand);
    }

    .hover-opacity-100:hover {
        opacity: 1 !important;
    }
</style>
